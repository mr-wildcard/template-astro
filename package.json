{
  "name": "template-astro",
  "version": "0.0.3",
  "packageManager": "pnpm@12.21.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "test:e2e": "playwright test",
    "test:e2e:update:snapshots": "pnpm test:e2e --update-snapshots"
  },
  "dependencies": {
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/sitemap": "3.7.5",
    "@tailwindcss/vite": "4.3.5",
    "@astrojs/ts-plugin": "1.11.0",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "astro": "7.4.12",
    "astro-icon": "1.2.0",
    "autoprefixer": "10.6.2",
    "cssnano": "9.9.0",
    "dotenv": "18.0.10",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
