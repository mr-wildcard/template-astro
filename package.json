{
  "name": "template-astro",
  "version": "0.0.3",
  "packageManager": "pnpm@12.5.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "test:e2e": "playwright test",
    "test:e2e:update:snapshots": "pnpm test:e2e --update-snapshots"
  },
  "dependencies": {
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.3",
    "@astrojs/ts-plugin": "1.10.12",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "astro": "7.3.5",
    "astro-icon": "1.2.0",
    "autoprefixer": "10.6.1",
    "cssnano": "9.0.5",
    "dotenv": "18.0.3",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.0.1",
    "typescript": "6.0.3",
    "vite": "8.3.1"
  }
}
